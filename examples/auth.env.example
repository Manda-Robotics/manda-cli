# Optional custom/development overrides. The official hosted client needs none of these.
# The Supabase publishable key is intentionally safe to distribute.
MANDA_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
MANDA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional; this is the default derived from MANDA_SUPABASE_URL.
# MANDA_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/manda-access

# Optional local overrides.
# MANDA_SESSION_FILE=/absolute/path/to/private/session.json
# ROBOLAB_STORAGE_RCLONE_BINARY=/absolute/path/to/rclone
# ROBOLAB_ARTIFACT_CACHE=/absolute/path/to/manda-artifact-cache

# Optional benchmark durability behavior.
# ROBOLAB_STORAGE_AUTO_FINALIZE=1
# ROBOLAB_STORAGE_CHECKPOINT_ON_FAILURE=1
# ROBOLAB_STORAGE_CHECKPOINT_INTERVAL_SECONDS=600
