# Provider-neutral artifact storage. Copy this to a private path, chmod it and the key file 600,
# and source it with `set -a; source /path/to/storage.env; set +a`.
ROBOLAB_STORAGE_BUCKET=manda-pilot-storage
ROBOLAB_STORAGE_BUCKET_ID=ee0772e216a321cba808041f
ROBOLAB_STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
ROBOLAB_STORAGE_KEY_ID=YOUR_APPLICATION_KEY_ID
ROBOLAB_STORAGE_APPLICATION_KEY_FILE=/absolute/path/to/backblaze-app-key
ROBOLAB_STORAGE_PREFIX=robolab/v1

# Give every benchmark producer a stable, unique ID (for example vast-metz or runpod-colleague).
ROBOLAB_STORAGE_PRODUCER_ID=replace-me

# Opt in to automatic durable publication after a successful planned job and fault-tolerance
# checkpointing after a failed job.
ROBOLAB_STORAGE_AUTO_FINALIZE=1
ROBOLAB_STORAGE_CHECKPOINT_ON_FAILURE=1
ROBOLAB_STORAGE_CHECKPOINT_INTERVAL_SECONDS=600

# Optional local materialization cache used when analysis commands receive a remote run ID.
# ROBOLAB_ARTIFACT_CACHE=/absolute/path/to/robolab-artifact-cache
